# Server Port
PORT=5000

# ==============================================================================
# MONGODB CONNECTION STRING
# ==============================================================================
# To use MongoDB Atlas:
# 1. Log in to your MongoDB Atlas dashboard (https://cloud.mongodb.com).
# 2. Click "Connect" on your Database Cluster -> Choose "Drivers" (Node.js).
# 3. Copy the connection string and paste it below, replacing <db_username> and <db_password>.
# Example Atlas format:
# MONGODB_URI=mongodb+srv://admin:YourSecurePassword@cluster0.abcde.mongodb.net/habittracker?retryWrites=true&w=majority&appName=HabitTracker
#
# For local MongoDB instance:
MONGODB_URI=mongodb://localhost:27017/habittracker

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
# Secret key used to sign and verify JSON Web Tokens (min 32 chars in production)
JWT_SECRET=habittracker_super_secret_jwt_key_2026_production_grade_32chars

# Expiration period for JWT (e.g., 1d, 7d, 30d)
JWT_EXPIRES_IN=7d

# ==============================================================================
# CORS & FRONTEND
# ==============================================================================
# Allowed client origin URL (Must match the React Vite development or production URL)
CLIENT_ORIGIN=http://localhost:5173
